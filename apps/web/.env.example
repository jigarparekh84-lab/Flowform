# Local only — copy to .env.local (gitignored)
# Basemap: openfreemap (default, free commercial, no key) | carto
VITE_BASEMAP=openfreemap
# Only needed if VITE_BASEMAP=carto
VITE_CARTO_API_KEY=
VITE_API_URL=http://127.0.0.1:5182
# Projects: api (default — mirror to /v1/projects, local fallback) | local (browser only)
VITE_PROJECT_STORE=api
# Dev-bypass identity (API must run with AUTH_MODE=dev); blank = API default dev tenant
VITE_DEV_TENANT=
VITE_DEV_USER=
