{
  "name": "flowform-web",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "gen:pack-parity": "tsx scripts/gen-pack-parity.mts",
    "test:enterprise": "tsx src/data/enterprisePack.test.ts",
    "test:cts": "tsx src/data/costToServe.test.ts",
    "test:defects": "tsx src/data/defectFixes.test.ts",
    "test:data": "npm run test:enterprise && npm run test:cts && npm run test:defects && npm run test:sync && npm run test:validation && npm run test:onboarding && npm run test:narrative && npm run test:jobs && npm run test:auth && npm run test:reporting",
    "test:sync": "tsx src/data/workspaceSync.test.ts",
    "test:validation": "tsx src/data/validation.test.ts",
    "test:onboarding": "tsx src/data/onboarding.test.ts",
    "test:narrative": "tsx src/data/narrative.test.ts",
    "test:jobs": "tsx src/data/jobsApi.test.ts",
    "test:auth": "tsx src/data/session.test.ts",
    "test:reporting": "tsx src/data/reporting.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sentry/browser": "^11.11.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.5"
  },
  "description": "Flowform — network/footprint design studio (web)"
}
