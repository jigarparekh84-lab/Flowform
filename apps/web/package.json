{
  "name": "flowform-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:enterprise": "npx --yes tsx src/data/enterprisePack.test.ts",
    "test:cts": "npx --yes tsx src/data/costToServe.test.ts",
    "test:defects": "npx --yes tsx src/data/defectFixes.test.ts",
    "test:data": "npm run test:enterprise && npm run test:cts && npm run test:defects && npm run test:sync",
    "test:sync": "npx --yes tsx src/data/workspaceSync.test.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Flowform — network/footprint design studio (web)"
}
